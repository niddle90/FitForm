{
  "name": "fitform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Client-side photo/PDF toolkit plus a private personal document vault backed by the user's own Google Drive. Fully static, no backend.",
  "scripts": {
    "postinstall": "node scripts/copy-wasm-assets.mjs && npm run build --prefix imaging",
    "dev": "vite",
    "build": "npm run build --prefix imaging && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke-test": "node scripts/smoke-test.mjs",
    "pipeline-test": "node --experimental-strip-types scripts/pipeline-test.mjs",
    "client-test": "node --experimental-strip-types scripts/client-test.mjs",
    "test": "npm run pipeline-test && npm run client-test && npm run smoke-test",
    "deploy": "VITE_BASE_PATH=/FitForm/ npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/boogaloo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imaging": "file:./imaging",
    "lucide-react": "0.545.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.2.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
